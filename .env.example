# Environment template for YouTube helpers (copy to .env — never commit .env)
#
# cp .env.example .env
#
# ELEVENLABS_API_KEY=your_key_here
# Optional voice overrides (ElevenLabs voice IDs).
# Default EN is premade Adam (free-tier friendly). Library voices often 402.
# ELEVENLABS_VOICE_ID_EN=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_VOICE_ID_ZH=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
#
# OpenAI (images_openai.py + optional publish.py --openai):
# OPENAI_API_KEY=sk-...
# YOUTUBE_OPENAI_IMAGE_MODEL=gpt-image-1
