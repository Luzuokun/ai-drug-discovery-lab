# Environment template for YouTube helpers (copy to .env — never commit .env)
#
# cp .env.example .env
#
# ELEVENLABS_API_KEY=your_key_here
# Optional voice overrides (ElevenLabs voice IDs):
# ELEVENLABS_VOICE_ID_EN=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_VOICE_ID_ZH=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
#
# Optional OpenAI path for publish.py --openai:
# OPENAI_API_KEY=sk-...
